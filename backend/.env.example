# =============================================================================
# VoiceInterview AI — Environment Variables
# Copy this file to .env and fill in your values
# =============================================================================

# Server
NODE_ENV=development
PORT=4000

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/voice_interview

# JWT Authentication
JWT_SECRET=change-this-to-a-random-64-char-string

# Frontend URL (for CORS, Stripe redirects, email links)
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# OpenAI (primary AI provider)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Anthropic (fallback AI provider)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# LiveKit (WebRTC voice sessions)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://your-livekit-server.livekit.cloud

# Stripe (payments)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
